{{- $index := slice -}}
{{- range where .Site.RegularPages "Section" "posts" -}}
  {{- $entry := dict
    "title"       .Title
    "description" .Description
    "content"     (.Content | plainify | htmlUnescape)
    "permalink"   .Permalink
    "tags"        .Params.tags
    "date"        (.Date.Format "2006-01-02")
    "cover"       (cond (isset .Params "cover") (partial "cover-src.html" (dict "cover" .Params.cover "ext" "webp")) "")
  -}}
  {{- $index = $index | append $entry -}}
{{- end -}}
{{- $index | jsonify -}}
